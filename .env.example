# JarcTech Ticket server settings. PLACEHOLDERS ONLY. Never commit real values or paste them into chat, issues, or pull requests.
# Local: copy this file to .env (Git ignores .env) and edit it. Railway: enter the same names under the service's Variables.
# Settings already present in the environment (for example Railway variables) always win over .env.

# --- Server ---
# development (default), test, or production. Use production on Railway.
NODE_ENV=development
# Railway sets PORT itself; do not add PORT in Railway. Local default is 4175.
PORT=4175
# Optional. Defaults to 127.0.0.1 locally and 0.0.0.0 in production or on Railway.
# HOST=127.0.0.1

# --- MongoDB ---
# Leave both lines out (or delete them from .env) to run the browser-only prototype without a database.
# When deployed, both are required. Use a separate database and a least-privilege user for each environment;
# point local development at a development database, never production.
# Special characters in the password must be URL-encoded (for example @ becomes %40 and # becomes %23);
# an unencoded # starts a comment and cuts the value short.
# Atlas: Connect > Drivers shows this string. Local development uses jarctech_ticket_dev.
MONGODB_URI=mongodb+srv://<db-user>:<db-password>@<cluster-host>/?retryWrites=true&w=majority
MONGODB_DB_NAME=<database-name>

# --- Sign-in (see docs/AUTH-DESIGN.md and README "Microsoft Entra sign-in") ---
# demo  = browser-only prototype, local use only (also the default when AUTH_MODE is unset locally).
# entra = Microsoft Entra sign-in required; needs MongoDB and every setting below. Required when deployed.
# Entra settings without AUTH_MODE are an error, never a silent fallback to demo mode.
# AUTH_MODE=entra
# Local development: http://localhost:4177 with PORT=4177 (the redirect URI is APP_BASE_URL + /auth/callback).
# APP_BASE_URL=<public-url-of-this-environment>
# At least 32 random characters, unique per environment. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# SESSION_SECRET=<long-random-value-unique-per-environment>
# Directory (tenant) ID and Application (client) ID from the app registration's Overview page (GUIDs).
# ENTRA_TENANT_ID=<directory-tenant-id>
# ENTRA_CLIENT_ID=<application-client-id>
# The client secret's Value (not its Secret ID), from Certificates & secrets.
# ENTRA_CLIENT_SECRET=<client-secret-value>
