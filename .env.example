# Local settings. Copy to .env, which Git ignores. Deployed settings live in Railway variables, never in Git.
# With nothing set, `npm start` runs the browser-only demo for local use.

# MONGODB_URI=mongodb://127.0.0.1:27017/
# MONGODB_DB_NAME=jarctech_ticket_dev

# Microsoft sign-in. Required when deployed.
# AUTH_MODE=entra
# ACCESS_POLICY=tenant-members
# APP_BASE_URL=http://localhost:4175
# ENTRA_TENANT_ID=<directory-tenant-id>
# ENTRA_CLIENT_ID=<application-client-id>
# ENTRA_CLIENT_SECRET=<client-secret>
# SESSION_SECRET=<at-least-32-random-characters>

# Local and test only. The server refuses to start with either enabled when deployed, or if APP_BASE_URL is not localhost.
# BETA_SIMULATION=enabled
# INSPECTION_MODE=enabled

# Optional.
# ATTACHMENT_QUOTA_MB=200
# EMAIL_DELIVERY=resend
# EMAIL_FROM=JarcTech Ticket <tickets@your-domain>
# RESEND_API_KEY=<key>
